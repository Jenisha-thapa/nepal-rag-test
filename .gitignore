# ── Python / uv ─────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Secrets: never commit API keys ──────────────────────────────────────────
.env
.env.*
!.env.example

# ── Data ────────────────────────────────────────────────────────────────────
# Committed on purpose so a fresh clone runs without re-crawling:
#   data/raw/                       crawl snapshot (pages + .meta.json: URL, fetch time, sha256)
#   data/chunks/                    the knowledge base (new_chunks.json)
#   data/eval/                      retrieval benchmark
#   data/processed/all_chunks.json  chunks the retriever loads
# Built from the chunks on the first start (or `uv run nepal-rag build`), once per machine:
data/index/
# Regenerated by `uv run nepal-rag build` (auto-chunking mode intermediates):
data/processed/*/
# Per-domain outputs of the extraction agents, already merged into data/chunks/new_chunks.json
data/chunks_add/

# ── Logs / temp ─────────────────────────────────────────────────────────────
logs/
*.log
*.tmp

# ── OS / editors ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# PDFs downloaded by hand, waiting for `uv run nepal-rag import`
data/raw/_inbox/

# Web chat history (user ids + conversations), created on first use
data/conversations.db
data/conversations.db-*
