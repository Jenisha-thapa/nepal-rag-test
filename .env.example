# Copy to .env and fill in what you use:   copy .env.example .env
# Values here override config/settings.yaml → generation.*

# ── LLM chain: primary provider → fallback provider → extractive (no LLM) ──────
# Primary: ollama | gemini | openai | openrouter | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3

# Fallback used when the primary is unavailable (e.g. Ollama not running or model not pulled)
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# ── Provider credentials ─────────────────────────────────────────────────────
# Gemini — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ollama — local, no key. Pull a model first, e.g.:  ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
